+++ b/net/minecraft/core/dispenser/DispenseItemBehavior.java
@@ -292,6 +292,7 @@ public interface DispenseItemBehavior {
                     return result;
                 }
                 // Paper end - Call BlockDispenseEvent
+                kirigami.parallel.WorldPause.exclusiveRun("dispenser fertilising", () -> { // MT
                 List<org.bukkit.craftbukkit.block.CraftBlockState> capturedBlockStates; // Paper
                 org.bukkit.TreeType treeType; // Paper
                 level.captureTreeGeneration = true; // CraftBukkit
@@ -333,6 +334,7 @@ public interface DispenseItemBehavior {
                     }
                 }
                 // CraftBukkit end
+                }); // MT
 
                 return dispensed;
             }
diff --git a/net/minecraft/world/item/crafting/RecipeCache.java b/net/minecraft/world/item/crafting/RecipeCache.java
index 08438b48f15912cae0ae56d9d2ec2baf880efd27..d872332f13f4a883e80dc20c853b2dd953d65266 100644
--- a/net/minecraft/world/item/crafting/RecipeCache.java
+++ b/net/minecraft/world/item/crafting/RecipeCache.java
@@ -16,7 +16,7 @@ public class RecipeCache {
         this.entries = new RecipeCache.Entry[capacity];
     }
 
-    public Optional<RecipeHolder<CraftingRecipe>> get(final ServerLevel level, final CraftingInput input) {
+    public synchronized Optional<RecipeHolder<CraftingRecipe>> get(final ServerLevel level, final CraftingInput input) { // MT
         if (input.isEmpty()) {
             return Optional.empty();
         }
