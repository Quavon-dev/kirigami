From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leopold <77323443+MadebyLeopold@users.noreply.github.com>
Date: Fri, 16 Oct 2026 15:21:26 +0200
Subject: [PATCH] Parallel villager ticking


diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index b437c66a9136162ac2367f4773bd0f2e21c17e99..cd7198fd2b9c15fa3de8db548ed021314190b04a 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -103,8 +103,12 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         this.chunkHoldersToBroadcast.remove(chunkHolder.vanillaChunkHolder);
     }
 
-    private ChunkAccess syncLoad(final int chunkX, final int chunkZ, final ChunkStatus toStatus) {
+    private ChunkAccess syncLoad(final int chunkX, final int chunkZ, final ChunkStatus toStatus) { // MT
         mtserver.parallel.CellContext.recordBlockingLoad(this.level); // MT
+        return mtserver.parallel.CellContext.exclusive(this.level, () -> this.mtSyncLoad(chunkX, chunkZ, toStatus)); // MT
+    } // MT
+
+    private ChunkAccess mtSyncLoad(final int chunkX, final int chunkZ, final ChunkStatus toStatus) { // MT
         final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler chunkTaskScheduler = ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.level).moonrise$getChunkTaskScheduler();
         final CompletableFuture<ChunkAccess> completable = new CompletableFuture<>();
         chunkTaskScheduler.scheduleChunkLoad(
diff --git a/net/minecraft/world/entity/ai/village/poi/PoiManager.java b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
index 1e9a9e78dc278d4a686049a1b898c03b8167ba6e..8320d07c60b2600094fcfc9c845c892f879f2d68 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiManager.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
@@ -60,11 +60,14 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
     }
 
     private void updateDistanceTracking(long section) {
-        if (this.isVillageCenter(section)) {
+        final boolean villageCenter = this.isVillageCenter(section); // MT
+        synchronized (this.villageDistanceTracker) { // MT
+        if (villageCenter) { // MT
             this.villageDistanceTracker.setSource(section, POI_DATA_SOURCE);
         } else {
             this.villageDistanceTracker.removeSource(section);
         }
+        } // MT
     }
 
     @Override
@@ -98,7 +101,7 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
                 return ret.getSectionForVanilla(chunkY);
             } else {
                 mtserver.parallel.CellContext.recordBlockingLoad(this.world); // MT
-                return manager.loadPoiChunk(chunkX, chunkZ).getSectionForVanilla(chunkY);
+                return mtserver.parallel.CellContext.exclusive(this.world, () -> manager.loadPoiChunk(chunkX, chunkZ)).getSectionForVanilla(chunkY); // MT
             }
         }
         // retain vanilla behavior: do not load section if out of bounds!
@@ -119,7 +122,7 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
         if (ret != null) {
             return ret.getOrCreateSection(chunkY);
         } else {
-            return manager.loadPoiChunk(chunkX, chunkZ).getOrCreateSection(chunkY);
+            return mtserver.parallel.CellContext.exclusive(this.world, () -> manager.loadPoiChunk(chunkX, chunkZ)).getOrCreateSection(chunkY); // MT
         }
     }
 
@@ -424,8 +427,10 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
 
     public int sectionsToVillage(final SectionPos sectionPos) {
         // Paper start - rewrite chunk system
+        synchronized (this.villageDistanceTracker) { // MT
         this.villageDistanceTracker.propagateUpdates();
         return convertBetweenLevels(this.villageDistanceTracker.getLevel(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionKey(sectionPos)));
+        } // MT
         // Paper end - rewrite chunk system
     }
 
@@ -437,7 +442,7 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
 
     @Override
     public void tick(final BooleanSupplier haveTime) {
-        this.villageDistanceTracker.propagateUpdates(); // Paper - rewrite chunk system
+        synchronized (this.villageDistanceTracker) { this.villageDistanceTracker.propagateUpdates(); } // Paper - rewrite chunk system // MT
     }
 
     @Override
diff --git a/net/minecraft/world/entity/ai/village/poi/PoiRecord.java b/net/minecraft/world/entity/ai/village/poi/PoiRecord.java
index 1b2f8249957a642b14fccab0d8dd2c41a97b63a7..8429708f3a470a526748cfb8ca55944d926ae21e 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiRecord.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiRecord.java
@@ -36,7 +36,7 @@ public class PoiRecord {
         return this.freeTickets;
     }
 
-    protected boolean acquireTicket() {
+    protected synchronized boolean acquireTicket() { // MT
         if (this.freeTickets <= 0) {
             return false;
         }
@@ -46,7 +46,7 @@ public class PoiRecord {
         return true;
     }
 
-    protected boolean releaseTicket() {
+    protected synchronized boolean releaseTicket() { // MT
         if (this.freeTickets >= this.poiType.value().maxTickets()) {
             return false;
         }
