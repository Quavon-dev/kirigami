Subject: [PATCH] Parallel natural spawning


diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index c4cfb53e145d69666ffc27ef4ee0c50b54eb9143..f4cbc584de92d1e809c3f684d5293831661f0819 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -154,6 +154,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             }
         }
 
+        if (load) mtserver.parallel.Speculation.abortIfActive(); // MT
         return load ? this.syncLoad(chunkX, chunkZ, toStatus) : null;
     }
     // Paper end - rewrite chunk system
@@ -600,9 +601,13 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             // Paper end - chunk tick iteration optimisation
             profiler.popPush("tickSpawningChunks");
 
+            if (mtserver.parallel.ParallelSpawning.ENABLED) { // MT
+                mtserver.parallel.ParallelSpawning.tickSpawningChunks(this.level, spawningChunks, spawningCategories, spawnCookie);
+            } else {
             for (LevelChunk chunk : spawningChunks) {
                 this.tickSpawningChunk(chunk, spawningCategories, spawnCookie);
             }
+            } // MT
         } finally {
             spawningChunks.clear();
         }
diff --git a/net/minecraft/world/attribute/EnvironmentAttributeSystem.java b/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
index b4a076292c17a9216764db4e0074315eca3127aa..32824c640792c90a34e9ad1dee29ff5e2b55a2ad 100644
--- a/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
+++ b/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
@@ -105,6 +105,10 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
         );
     }
 
+    public void prepareForConcurrentReads() {
+        this.attributeSamplers.values().forEach(EnvironmentAttributeSystem.ValueSampler::getDimensionValue);
+    }
+
     public void invalidateTickCache() {
         this.attributeSamplers.values().forEach(EnvironmentAttributeSystem.ValueSampler::invalidateTickCache);
     }
