+++ b/ca/spottedleaf/moonrise/paper/PaperHooks.java
@@ -164,7 +164,7 @@ public final class PaperHooks extends BaseChunkSystemHooks implements PlatformHo
 
     @Override
     public boolean configFixMC224294() {
-        return true;
+        return kirigami.VanillaParity.PAPER_FLUID_RANDOM_TICK_FIX; // MT
     }
 
     @Override
diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index f042ddf76f3a39c389e099f09dd5cb07483d2046..888c53f82fb3c11d90fc74dd95c9d24d03430eb4 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -223,7 +223,7 @@ public abstract class PathNavigation {
 
     public boolean moveTo(final Entity target, final int reachRange, final double speedModifier) {
         // Paper start - Perf: Optimise pathfinding
-        if (this.pathfindFailures > 10 && this.path == null && net.minecraft.server.MinecraftServer.currentTick < this.lastFailure + 40) {
+        if (kirigami.VanillaParity.PAPER_PATHFINDING_BACKOFF && this.pathfindFailures > 10 && this.path == null && net.minecraft.server.MinecraftServer.currentTick < this.lastFailure + 40) { // MT
             return false;
         }
         // Paper end - Perf: Optimise pathfinding
diff --git a/net/minecraft/world/entity/raid/Raider.java b/net/minecraft/world/entity/raid/Raider.java
index 9d242f24c37fec196f06b8ef6fa29a66b2781c68..444716bfe3fa521e01b6e0119b2597076b431068 100644
--- a/net/minecraft/world/entity/raid/Raider.java
+++ b/net/minecraft/world/entity/raid/Raider.java
@@ -396,7 +396,7 @@ public abstract class Raider extends PatrollingMonster {
         }
 
         private boolean cannotPickUpBanner() {
-            if (!getServerLevel(this.mob).getGameRules().get(net.minecraft.world.level.gamerules.GameRules.MOB_GRIEFING)) return true; // Paper - respect game and entity rules for picking up items
+            if (kirigami.VanillaParity.PAPER_RAID_BANNER_GRIEFING && !getServerLevel(this.mob).getGameRules().get(net.minecraft.world.level.gamerules.GameRules.MOB_GRIEFING)) return true; // Paper - respect game and entity rules for picking up items // MT
             if (!this.mob.hasActiveRaid()) {
                 return true;
             }
diff --git a/net/minecraft/world/entity/raid/Raids.java b/net/minecraft/world/entity/raid/Raids.java
index bc0f31a16f7b055e85f10eda377026a927032535..51f70b5d07354998a579c748ac726155c624ac25 100644
--- a/net/minecraft/world/entity/raid/Raids.java
+++ b/net/minecraft/world/entity/raid/Raids.java
@@ -138,7 +138,7 @@ public class Raids extends SavedData {
         //     this.raidMap.put(this.getUniqueId(), raid);
         // }
 
-        if (!raid.isStarted() || (raid.isInProgress() && raid.getRaidOmenLevel() < raid.getMaxRaidOmenLevel())) { // CraftBukkit - fixed a bug with raid: players could add up Bad Omen level even when the raid had finished
+        if (!raid.isStarted() || ((!kirigami.VanillaParity.CRAFTBUKKIT_RAID_OMEN_FIX || raid.isInProgress()) && raid.getRaidOmenLevel() < raid.getMaxRaidOmenLevel())) { // CraftBukkit - fixed a bug with raid: players could add up Bad Omen level even when the raid had finished // MT
             // CraftBukkit start
             if (!org.bukkit.craftbukkit.event.CraftEventFactory.callRaidTriggerEvent(level, raid, player)) {
                 player.removeEffect(net.minecraft.world.effect.MobEffects.RAID_OMEN);
diff --git a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
index 6c9ec44a46b6f40a2b8b008cc50c0cafe5e909e6..ad8684fcba98eb3d9f4ada593a8cc66768095bbf 100644
--- a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
+++ b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
@@ -607,7 +607,7 @@ public abstract class AbstractBoat extends VehicleEntity implements Leashable {
             this.waterLevel = this.getY(1.0);
             double targetY = this.getWaterLevelAbove() - this.getBbHeight() + 0.101;
             if (this.level().noCollision(this, this.getBoundingBox().move(0.0, targetY - this.getY(), 0.0))) {
-                this.move(MoverType.SELF, new Vec3(0.0, targetY - this.getY(), 0.0)); // Paper - Fix some exploit with boats // TODO Still needed?
+                if (kirigami.VanillaParity.PAPER_BOAT_RISE_COLLISION) this.move(MoverType.SELF, new Vec3(0.0, targetY - this.getY(), 0.0)); else this.setPos(this.getX(), targetY, this.getZ()); // Paper - Fix some exploit with boats // TODO Still needed? // MT
                 this.setDeltaMovement(this.getDeltaMovement().multiply(1.0, 0.0, 1.0));
                 this.lastYd = 0.0;
             }
diff --git a/net/minecraft/world/level/block/entity/ContainerOpenersCounter.java b/net/minecraft/world/level/block/entity/ContainerOpenersCounter.java
index 6aed471bbf59330d58677bb0334e14ca23dadeff..56197b6b3e1905eae9223a6b8043d75ec7d501e0 100644
--- a/net/minecraft/world/level/block/entity/ContainerOpenersCounter.java
+++ b/net/minecraft/world/level/block/entity/ContainerOpenersCounter.java
@@ -73,7 +73,7 @@ public abstract class ContainerOpenersCounter {
 
     public void decrementOpeners(final LivingEntity entity, final Level level, final BlockPos pos, final BlockState blockState) {
         // Paper start - delay close callbacks
-        if (this.delayCallbacks()) {
+        if (this.delayCallbacks() && kirigami.VanillaParity.PAPER_CHEST_DELAY) { // MT
             scheduleRecheck(level, pos, blockState, 1);
             return;
         }
