Subject: [PATCH] Vanilla parity switches


diff --git a/ca/spottedleaf/moonrise/paper/PaperHooks.java b/ca/spottedleaf/moonrise/paper/PaperHooks.java
index 76f990f150f040b1ad6d7d5b91cfb34ebd6f436a..09151a64b85702ad0f007c83a69e53eb2a9ee1a2 100644
